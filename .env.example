# Oracle source database
ORACLE_DSN=oracle+oracledb://user:password@host:1521/?service_name=ORCL

# MSSQL target database (mssql-python format — no ODBC driver needed)
MSSQL_DSN=Server=host,1433;Database=dbname;UID=user;PWD=password;Encrypt=yes;

# ETL settings
BATCH_SIZE=1000
LOG_LEVEL=DEBUG

# Oracle LDAP connection (alternative to ORACLE_DSN)
# ORACLE_LDAP_HOST=ldap.example.com
# ORACLE_LDAP_PORT=389
# ORACLE_LDAP_DN=cn=OracleContext,dc=example,dc=com
# ORACLE_LDAP_USER=oracle_user
# ORACLE_LDAP_PASSWORD=oracle_password
# ORACLE_LDAP_DB_SERVICE_NAME=ORCL
